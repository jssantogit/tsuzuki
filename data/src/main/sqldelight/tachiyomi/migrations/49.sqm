-- Host-only local consent for an EXACT publisher/work/edition/language.
-- This is not a publisher verification, authority certificate, backup entitlement,
-- reading provider, or sync record. There is deliberately no default grant.
CREATE TABLE tsuzuki_editorial_edition_consents(
    canonical_title_id TEXT NOT NULL,
    producer_id TEXT NOT NULL,
    external_work_id TEXT NOT NULL,
    edition_key TEXT NOT NULL,
    scope_language TEXT NOT NULL,
    granted_at INTEGER NOT NULL,
    integration_settings_revision INTEGER NOT NULL,
    revoked_at INTEGER,
    PRIMARY KEY(canonical_title_id, producer_id, external_work_id, edition_key, scope_language),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE RESTRICT
);
