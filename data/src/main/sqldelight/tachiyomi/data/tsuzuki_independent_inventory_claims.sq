-- Local-only metadata claims. These rows are never chapter identities or v1 sync entries.
CREATE TABLE tsuzuki_independent_inventory_claims(
    canonical_title_id TEXT NOT NULL,
    producer_id TEXT NOT NULL,
    external_work_id TEXT NOT NULL,
    edition_key TEXT NOT NULL,
    source_record_id TEXT NOT NULL,
    raw_label TEXT,
    raw_volume TEXT,
    language TEXT,
    claim_kind TEXT NOT NULL,
    derivation TEXT NOT NULL,
    upstream_source_id TEXT,
    work_verified INTEGER NOT NULL,
    edition_verified INTEGER NOT NULL,
    observed_at INTEGER NOT NULL,
    PRIMARY KEY(canonical_title_id, producer_id, external_work_id, edition_key, source_record_id),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_inventory_claims_title_index
ON tsuzuki_independent_inventory_claims(canonical_title_id);

-- Technical per-page fetch status; EXHAUSTED does not mean editorial completeness.
CREATE TABLE tsuzuki_independent_inventory_pages(
    canonical_title_id TEXT NOT NULL,
    producer_id TEXT NOT NULL,
    external_work_id TEXT NOT NULL,
    edition_key TEXT NOT NULL,
    page_key TEXT NOT NULL,
    language TEXT,
    work_verified INTEGER NOT NULL,
    edition_verified INTEGER NOT NULL,
    observed_at INTEGER NOT NULL,
    outcome TEXT NOT NULL,
    item_count INTEGER NOT NULL,
    declared_total INTEGER,
    next_cursor TEXT,
    PRIMARY KEY(canonical_title_id, producer_id, external_work_id, edition_key, page_key),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_inventory_pages_title_index
ON tsuzuki_independent_inventory_pages(canonical_title_id);

getTsuzukiIndependentInventoryClaimsByTitle:
SELECT
    canonical_title_id,
    producer_id,
    external_work_id,
    edition_key,
    source_record_id,
    raw_label,
    raw_volume,
    language,
    claim_kind,
    derivation,
    upstream_source_id,
    work_verified,
    edition_verified,
    observed_at
FROM tsuzuki_independent_inventory_claims
WHERE canonical_title_id = :canonicalTitleId
ORDER BY producer_id, external_work_id, edition_key, source_record_id;

getTsuzukiIndependentInventoryPagesByTitle:
SELECT
    canonical_title_id,
    producer_id,
    external_work_id,
    edition_key,
    page_key,
    language,
    work_verified,
    edition_verified,
    observed_at,
    outcome,
    item_count,
    declared_total,
    next_cursor
FROM tsuzuki_independent_inventory_pages
WHERE canonical_title_id = :canonicalTitleId
ORDER BY producer_id, external_work_id, edition_key, page_key;

upsertTsuzukiIndependentInventoryClaim:
INSERT INTO tsuzuki_independent_inventory_claims(
    canonical_title_id,
    producer_id,
    external_work_id,
    edition_key,
    source_record_id,
    raw_label,
    raw_volume,
    language,
    claim_kind,
    derivation,
    upstream_source_id,
    work_verified,
    edition_verified,
    observed_at
)
VALUES (
    :canonicalTitleId,
    :producerId,
    :externalWorkId,
    :editionKey,
    :sourceRecordId,
    :rawLabel,
    :rawVolume,
    :language,
    :claimKind,
    :derivation,
    :upstreamSourceId,
    :workVerified,
    :editionVerified,
    :observedAt
)
ON CONFLICT(canonical_title_id, producer_id, external_work_id, edition_key, source_record_id)
DO UPDATE SET
    raw_label = excluded.raw_label,
    raw_volume = excluded.raw_volume,
    language = excluded.language,
    claim_kind = excluded.claim_kind,
    derivation = excluded.derivation,
    upstream_source_id = excluded.upstream_source_id,
    work_verified = excluded.work_verified,
    edition_verified = excluded.edition_verified,
    observed_at = excluded.observed_at
WHERE excluded.observed_at > tsuzuki_independent_inventory_claims.observed_at;

upsertTsuzukiIndependentInventoryPage:
INSERT INTO tsuzuki_independent_inventory_pages(
    canonical_title_id,
    producer_id,
    external_work_id,
    edition_key,
    page_key,
    language,
    work_verified,
    edition_verified,
    observed_at,
    outcome,
    item_count,
    declared_total,
    next_cursor
)
VALUES (
    :canonicalTitleId,
    :producerId,
    :externalWorkId,
    :editionKey,
    :pageKey,
    :language,
    :workVerified,
    :editionVerified,
    :observedAt,
    :outcome,
    :itemCount,
    :declaredTotal,
    :nextCursor
)
ON CONFLICT(canonical_title_id, producer_id, external_work_id, edition_key, page_key)
DO UPDATE SET
    language = excluded.language,
    work_verified = excluded.work_verified,
    edition_verified = excluded.edition_verified,
    observed_at = excluded.observed_at,
    outcome = excluded.outcome,
    item_count = excluded.item_count,
    declared_total = excluded.declared_total,
    next_cursor = excluded.next_cursor
WHERE excluded.observed_at > tsuzuki_independent_inventory_pages.observed_at;
