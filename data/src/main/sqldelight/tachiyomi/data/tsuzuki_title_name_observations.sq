CREATE TABLE tsuzuki_title_name_observations(
    canonical_title_id TEXT NOT NULL,
    provider TEXT NOT NULL,
    source_key TEXT NOT NULL,
    value TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(canonical_title_id, provider, source_key, value),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_title_name_observation_title_index
ON tsuzuki_title_name_observations(canonical_title_id);

getTsuzukiTitleNameObservationsByTitle:
SELECT canonical_title_id, provider, source_key, value, updated_at
FROM tsuzuki_title_name_observations
WHERE canonical_title_id = :canonicalTitleId
ORDER BY updated_at DESC, provider ASC, source_key ASC, value ASC;

upsertTsuzukiTitleNameObservation:
INSERT INTO tsuzuki_title_name_observations(
    canonical_title_id,
    provider,
    source_key,
    value,
    updated_at
)
VALUES (
    :canonicalTitleId,
    :provider,
    :sourceKey,
    :value,
    :updatedAt
)
ON CONFLICT(canonical_title_id, provider, source_key, value) DO UPDATE SET
    updated_at = excluded.updated_at;
