CREATE TABLE tsuzuki_provider_bindings(
    id TEXT NOT NULL PRIMARY KEY,
    canonical_title_id TEXT NOT NULL,
    provider_id TEXT NOT NULL,
    facet_id TEXT NOT NULL,
    external_work_id TEXT NOT NULL,
    verification TEXT NOT NULL,
    availability TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE(provider_id, facet_id, external_work_id),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_provider_binding_title_index
ON tsuzuki_provider_bindings(canonical_title_id);

CREATE INDEX tsuzuki_provider_binding_provider_index
ON tsuzuki_provider_bindings(provider_id);

getTsuzukiProviderBinding:
SELECT *
FROM tsuzuki_provider_bindings
WHERE canonical_title_id = :canonicalTitleId
AND provider_id = :providerId
AND facet_id = :facetId
ORDER BY updated_at DESC, id ASC
LIMIT 1;

getTsuzukiProviderBindingsByTitle:
SELECT *
FROM tsuzuki_provider_bindings
WHERE canonical_title_id = :canonicalTitleId
ORDER BY created_at ASC, id ASC;

upsertTsuzukiProviderBinding:
INSERT INTO tsuzuki_provider_bindings(
    id,
    canonical_title_id,
    provider_id,
    facet_id,
    external_work_id,
    verification,
    availability,
    created_at,
    updated_at
)
VALUES (
    :id,
    :canonicalTitleId,
    :providerId,
    :facetId,
    :externalWorkId,
    :verification,
    :availability,
    :createdAt,
    :updatedAt
)
ON CONFLICT(id) DO UPDATE SET
    canonical_title_id = excluded.canonical_title_id,
    provider_id = excluded.provider_id,
    facet_id = excluded.facet_id,
    external_work_id = excluded.external_work_id,
    verification = excluded.verification,
    availability = excluded.availability,
    updated_at = excluded.updated_at;

markTsuzukiProviderBindingUnavailable:
UPDATE tsuzuki_provider_bindings
SET availability = 'UNAVAILABLE',
    updated_at = :updatedAt
WHERE id = :id;
