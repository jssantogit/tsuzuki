CREATE TABLE tsuzuki_canonical_chapters(
    id TEXT NOT NULL PRIMARY KEY,
    canonical_title_id TEXT NOT NULL,
    display_number TEXT NOT NULL,
    volume INTEGER,
    title TEXT,
    type TEXT NOT NULL,
    base_number INTEGER,
    part INTEGER,
    alpha_suffix TEXT,
    confidence REAL NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    confirmation_state TEXT NOT NULL DEFAULT 'PROVISIONAL',
    numbering_kind TEXT,
    decimal_numerator INTEGER,
    decimal_scale INTEGER,
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_canonical_chapter_title_index
ON tsuzuki_canonical_chapters(canonical_title_id);

-- Guard a previously accepted exact identity against stale legacy upserts or
-- competing updates through any SQL writer, not just the Kotlin repository.
-- Canonical title ID is intentionally mutable during safe title convergence.
CREATE TRIGGER tsuzuki_exact_chapter_identity_guard
BEFORE UPDATE ON tsuzuki_canonical_chapters
WHEN OLD.numbering_kind IS NOT NULL AND (
    NEW.numbering_kind IS NOT OLD.numbering_kind
    OR NEW.type IS NOT OLD.type
    OR NEW.base_number IS NOT OLD.base_number
    OR NEW.part IS NOT OLD.part
    OR NEW.alpha_suffix IS NOT OLD.alpha_suffix
    OR NEW.volume IS NOT OLD.volume
    OR NEW.decimal_numerator IS NOT OLD.decimal_numerator
    OR NEW.decimal_scale IS NOT OLD.decimal_scale
)
BEGIN
    SELECT RAISE(ABORT, 'Cannot overwrite an existing exact chapter identity');
END;

getTsuzukiCanonicalChaptersByTitle:
SELECT *
FROM tsuzuki_canonical_chapters
WHERE canonical_title_id = :canonicalTitleId
ORDER BY created_at ASC, id ASC;

getTsuzukiCanonicalChapterById:
SELECT *
FROM tsuzuki_canonical_chapters
WHERE id = :id
LIMIT 1;

upsertTsuzukiCanonicalChapter:
INSERT INTO tsuzuki_canonical_chapters(
    id,
    canonical_title_id,
    display_number,
    volume,
    title,
    type,
    base_number,
    part,
    alpha_suffix,
    confidence,
    created_at,
    updated_at,
    confirmation_state,
    numbering_kind,
    decimal_numerator,
    decimal_scale
)
VALUES (
    :id,
    :canonicalTitleId,
    :displayNumber,
    :volume,
    :title,
    :type,
    :baseNumber,
    :part,
    :alphaSuffix,
    :confidence,
    :createdAt,
    :updatedAt,
    :confirmationState,
    :numberingKind,
    :decimalNumerator,
    :decimalScale
)
ON CONFLICT(id) DO UPDATE SET
    canonical_title_id = excluded.canonical_title_id,
    display_number = excluded.display_number,
    volume = excluded.volume,
    title = excluded.title,
    type = excluded.type,
    base_number = excluded.base_number,
    part = excluded.part,
    alpha_suffix = excluded.alpha_suffix,
    confidence = excluded.confidence,
    updated_at = excluded.updated_at,
    confirmation_state = excluded.confirmation_state,
    numbering_kind = excluded.numbering_kind,
    decimal_numerator = excluded.decimal_numerator,
    decimal_scale = excluded.decimal_scale;


countTsuzukiCanonicalChapterProtectedState:
SELECT
    (SELECT count(*) FROM tsuzuki_chapter_progress WHERE canonical_chapter_id = :canonicalChapterId) +
    (SELECT count(*) FROM tsuzuki_chapter_history WHERE canonical_chapter_id = :canonicalChapterId) +
    (SELECT count(*) FROM tsuzuki_canonical_downloads WHERE canonical_chapter_id = :canonicalChapterId) +
    (SELECT count(*) FROM tsuzuki_chapter_update_state WHERE canonical_chapter_id = :canonicalChapterId) +
    (SELECT count(*) FROM tsuzuki_mihon_projection_queue WHERE canonical_chapter_id = :canonicalChapterId);

deleteTsuzukiCanonicalChapterById:
DELETE FROM tsuzuki_canonical_chapters
WHERE id = :canonicalChapterId;
