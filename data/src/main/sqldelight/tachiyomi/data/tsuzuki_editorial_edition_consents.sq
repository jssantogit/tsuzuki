-- Host-only local consent for an EXACT publisher/work/edition/language.
-- This is not a publisher verification, authority certificate, backup entitlement,
-- reading provider, or sync record. There is deliberately no default grant.
CREATE TABLE tsuzuki_editorial_edition_consents(
    canonical_title_id TEXT NOT NULL,
    producer_id TEXT NOT NULL,
    external_work_id TEXT NOT NULL,
    edition_key TEXT NOT NULL,
    scope_language TEXT NOT NULL,
    granted_at INTEGER NOT NULL,
    integration_settings_revision INTEGER NOT NULL,
    revoked_at INTEGER,
    PRIMARY KEY(canonical_title_id, producer_id, external_work_id, edition_key, scope_language),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE RESTRICT
);

upsertTsuzukiEditorialEditionConsent:
INSERT INTO tsuzuki_editorial_edition_consents(
    canonical_title_id, producer_id, external_work_id, edition_key,
    scope_language, granted_at, integration_settings_revision, revoked_at
) VALUES (
    :canonicalTitleId, :producerId, :externalWorkId, :editionKey,
    :scopeLanguage, :grantedAt, :integrationSettingsRevision, NULL
)
ON CONFLICT(canonical_title_id, producer_id, external_work_id, edition_key, scope_language)
DO UPDATE SET
    granted_at = excluded.granted_at,
    integration_settings_revision = excluded.integration_settings_revision,
    revoked_at = NULL;

revokeTsuzukiEditorialEditionConsent:
UPDATE tsuzuki_editorial_edition_consents
SET revoked_at = granted_at
WHERE canonical_title_id = :canonicalTitleId
  AND producer_id = :producerId
  AND external_work_id = :externalWorkId
  AND edition_key = :editionKey
  AND scope_language = :scopeLanguage
  AND revoked_at IS NULL;

countActiveTsuzukiEditorialEditionConsent:
SELECT count(*)
FROM tsuzuki_editorial_edition_consents
WHERE canonical_title_id = :canonicalTitleId
  AND producer_id = :producerId
  AND external_work_id = :externalWorkId
  AND edition_key = :editionKey
  AND scope_language = :scopeLanguage
  AND revoked_at IS NULL
  AND integration_settings_revision = (
      SELECT updated_at
      FROM tsuzuki_integration_settings
      WHERE integration_id = :producerId
      LIMIT 1
  );

countTsuzukiEditorialEditionConsentsForTitle:
SELECT count(*)
FROM tsuzuki_editorial_edition_consents
WHERE canonical_title_id = :canonicalTitleId;
